generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())
  reviews   Review[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  description     String?
  publishedYear   Int?
  copiesAvailable Int      @default(1)
  genreId         Int
  genre           Genre    @relation(fields: [genreId], references: [id])
  reviews         Review[]
  createdAt       DateTime @default(now())

  @@unique([title, author])
  @@index([genreId])
}

// Stretch: reviews link a User to a Book
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // expected range 1-5, validate in the API layer
  comment   String?
  bookId    Int
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookId, userId]) // one review per user per book
}
